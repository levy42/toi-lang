math = import math

-- First-class native calls provide an independent path through the same RNG.
draw = math.random
math.seed(12345)
expected = 0
for i in 1..20000
  expected += draw()
expected_next = draw()

fn random_sum(n)
  total = 0
  for i in 1..n
    total += math.random()
  return total

math.seed(12345)
assert random_sum(20000) == expected "native random must preserve the seeded stream"
assert math.random() == expected_next "native batching must consume exactly one draw per call"

-- Replacing a module value need not change its shape. Observe the live value,
-- and execute the replacement's effects exactly once when leaving native code.
state = {calls = 0}
fn replacement()
  state.calls = state.calls + 1
  return 0.5
math.random = replacement
assert random_sum(20000) == 10000
assert state.calls == 20000 "fallback must not replay or skip a replacement call"

math.random = draw
math.seed(12345)
assert random_sum(20000) == expected
assert math.random() == expected_next

-- The zero-argument specialization must not change range-call behavior.
for i in 1..2000
  one = math.random(1)
  bounded = math.random(4, 9)
  assert one == 1
  assert bounded >= 4 and bounded <= 9
assert math.random(0) == nil
assert math.random(9, 4) == nil
print "native random ok"
