http = import http
json = import json
string = import string
global table = import table
url = import url
uuid = import uuid
template = import template
types = import lib.types
html = import lib.html

LAYOUT_TEMPLATE = [[
<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}</title>
    <style>{{ styles }}</style>
  </head>
  <body>
    <header class="topbar">
      <h1>{{ app_title }}</h1>
      <nav>
        {% for item in nav_items %}
        <a href="{{ item.href }}">{{ item.label }}</a>
        {% endfor %}
      </nav>
    </header>
    <main>
      {{ body_html }}
    </main>
  </body>
</html>
]]

STYLES = [[
:root {
  --bg: #f5f7fb;
  --surface: #ffffff;
  --text: #1a2433;
  --muted: #60738a;
  --line: #d8dee8;
  --brand: #155eef;
  --danger: #b42318;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: linear-gradient(180deg, #eef3ff 0%, var(--bg) 180px);
  color: var(--text);
  font: 14px/1.5 "Iosevka", "Menlo", monospace;
}
.topbar {
  display: flex;
  gap: 16px;
  justify-content: space-between;
  align-items: center;
  padding: 18px 24px;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
}
.topbar h1 {
  margin: 0;
  font-size: 18px;
}
.topbar nav {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.topbar nav a {
  color: var(--brand);
  text-decoration: none;
  border: 1px solid var(--line);
  padding: 4px 8px;
  border-radius: 8px;
  background: #fff;
}
main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 20px;
}
.panel {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 16px;
}
.panel + .panel {
  margin-top: 16px;
}
.toolbar {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
  align-items: center;
  flex-wrap: wrap;
}
a.btn,
button.btn {
  display: inline-block;
  border: 1px solid var(--line);
  background: #fff;
  border-radius: 8px;
  color: var(--text);
  text-decoration: none;
  padding: 6px 10px;
  cursor: pointer;
}
a.btn.primary,
button.btn.primary {
  border-color: var(--brand);
  background: var(--brand);
  color: #fff;
}
button.btn.danger {
  border-color: var(--danger);
  color: var(--danger);
}
.table-wrap {
  overflow-x: auto;
}
table {
  border-collapse: collapse;
  width: 100%;
  font-size: 13px;
}
th, td {
  border: 1px solid var(--line);
  padding: 6px 8px;
  text-align: left;
  vertical-align: top;
}
th {
  background: #f8f9fc;
}
form.inline {
  display: inline;
}
input[type="text"],
input[type="number"],
textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 8px;
  font: inherit;
  background: #fff;
}
label.field {
  display: block;
  margin-bottom: 12px;
}
label.field > span {
  display: block;
  margin-bottom: 4px;
  color: var(--muted);
}
.error {
  border: 1px solid #fecdca;
  background: #fef3f2;
  color: #b42318;
  border-radius: 8px;
  padding: 8px;
  margin-bottom: 10px;
}
small.meta {
  color: var(--muted);
}
]]

render_layout = template.compile(LAYOUT_TEMPLATE)

fn normalize_mount_path(path)
  if type(path) != "string" or path == ""
    return "/admin"

  out = path
  if out[1] != "/"
    out = "/" + out
  while #out > 1 and out[#out] == "/"
    out = out[..-2]
  return out

fn copy_list(values)
  out = {}
  if type(values) == "table"
    for v in values
      out <+ v
  return out

fn title_case(s)
  if type(s) != "string" or s == ""
    return "Model"
  return " ".join(s.split("_"))

fn get_header(req, name)
  if type(req) != "table" or type(req.headers) != "table"
    return nil
  key = name.lower()
  return req.headers[key] or req.headers[name]

fn parse_int(raw, fallback, min_value = nil, max_value = nil)
  n = fallback
  try
    if raw != nil
      n = int(raw)
  except e
    n = fallback

  if min_value != nil and n < min_value
    return min_value
  if max_value != nil and n > max_value
    return max_value
  return n

fn parse_key_value(raw)
  out = {}
  if type(raw) != "string" or raw == ""
    return out

  for piece in raw.split("&")
    if piece == ""
      continue

    eq_i = piece.find("=")
    key_raw = piece
    val_raw = ""
    if eq_i != nil
      key_raw = piece.sub(1, eq_i - 1)
      val_raw = piece.sub(eq_i + 1)

    fixed_key = " ".join(key_raw.split("+"))
    fixed_val = " ".join(val_raw.split("+"))
    key = url.decode(fixed_key)
    val = url.decode(fixed_val)
    out[key] = val

  return out

fn request_query(req)
  raw = req.query
  if raw == nil and type(req.path) == "string"
    q_i = req.path.find("?")
    if q_i != nil
      raw = req.path.sub(q_i + 1)
  if type(raw) != "string"
    return {}
  if #raw > 0 and raw[1] == "?"
    raw = raw[2..]
  return parse_key_value(raw)

fn request_data(req)
  content_type = str(get_header(req, "content-type") or "").lower()
  body = req.body or ""

  if content_type.find("application/json") != nil
    decoded = nil
    try
      decoded = json.decode(body)
    except e
      decoded = {}
    if type(decoded) == "table"
      return decoded
    return {}

  return parse_key_value(body)

fn encode_query(params)
  parts = {}
  if type(params) != "table"
    return ""

  for k, v in params
    if v == nil
      continue
    s = str(v)
    if s == ""
      continue
    parts <+ string.format("%s=%s", url.encode(str(k)), url.encode(s))

  if #parts == 0
    return ""
  return string.format("?%s", "&".join(parts))

fn html_response(body, status = 200, headers = nil)
  hdrs = { ["Content-Type"] = "text/html; charset=utf-8" }
  if type(headers) == "table"
    for k, v in headers
      hdrs[k] = v
  return http.response(status, hdrs, body)

fn redirect_response(path)
  return http.response(302, {
    ["Location"] = path,
    ["Content-Type"] = "text/plain; charset=utf-8"
  }, "redirect")

fn display_value(value)
  if value == nil
    return ""
  if type(value) == "boolean"
    return value ? "true" : "false"
  return str(value)

fn allowed_field(fields, name)
  for field in fields
    if field == name
      return true
  return false

fn base_type(type_def)
  current = type_def
  i = 0
  while type(current) == "table" and current.inner != nil and i < 6
    current = current.inner
    i = i + 1
  return current

fn infer_field_kind(schema, field, opts = nil)
  if type(opts) == "table" and type(opts[field]) == "string"
    return opts[field]

  type_def = nil
  if type(schema) == "table" and type(schema.schema) == "table"
    type_def = schema.schema[field]
  type_def = base_type(type_def)

  if type_def == types.Boolean or type_def == types.Bool
    return "bool"
  if type_def == types.Integer or type_def == types.Int
    return "int"
  if type_def == types.Number
    return "number"
  return "text"

fn render_form_field(meta, field, row_data)
  field_label = title_case(field)
  kind = infer_field_kind(meta.schema, field, meta.field_types)
  value = row_data[field]

  if kind == "bool"
    attrs = {
      type = "checkbox",
      name = field,
      value = "true"
    }
    if value
      attrs.checked = true
    control = html.input(field, nil, attrs)
    return html.tag("label", {class = "field"}, control + " " + html.text(field_label))

  if kind == "textarea"
    control = html.textarea(field, display_value(value), {rows = 6})
    return html.tag("label", {class = "field"}, html.tag("span", nil, html.text(field_label)) + control)

  input_type = "text"
  attrs = {}
  if kind == "int"
    input_type = "number"
    attrs.step = "1"
  elif kind == "number"
    input_type = "number"
    attrs.step = "any"

  attrs.type = input_type
  control = html.input(field, display_value(value), attrs)
  return html.tag("label", {class = "field"}, html.tag("span", nil, html.text(field_label)) + control)

fn render_page(admin, page_title, body_html)
  nav_items = {}
  for meta in admin.models
    nav_items <+ {
      href = admin.mount_path + "/" + meta.name,
      label = meta.label
    }

  doc = render_layout({
    page_title = page_title,
    app_title = admin.title,
    styles = STYLES,
    nav_items = nav_items,
    body_html = body_html
  })
  return html_response(doc)

fn render_not_found(admin, msg = "Not Found")
  body = html.tag("section", {class = "panel"}, html.tag("h2", nil, "Admin") + html.tag("p", nil, html.text(msg)))
  return render_page(admin, "Admin", body)

fn model_meta_for(admin, model_name)
  return admin.model_by_name[model_name]

fn coerce_field_value(meta, field, raw_value)
  kind = infer_field_kind(meta.schema, field, meta.field_types)
  if kind == "bool"
    if raw_value == nil
      return false
    s = str(raw_value).lower()
    return s == "true" or s == "1" or s == "on" or s == "yes"

  type_def = nil
  if type(meta.schema) == "table" and type(meta.schema.schema) == "table"
    type_def = meta.schema.schema[field]

  if type_def == nil
    return raw_value
  return types.validate(type_def, raw_value, {coerce = true})

fn build_form_values(meta, payload, current_row = nil)
  out = {}
  for field in meta.form_fields
    if payload[field] != nil
      out[field] = payload[field]
    elif type(current_row) == "table"
      out[field] = current_row[field]
    else
      out[field] = nil
  return out

fn form_to_row(meta, payload, current_row = nil)
  row = {}
  if type(current_row) == "table"
    row = table.clone(current_row)

  for field in meta.form_fields
    row[field] = coerce_field_value(meta, field, payload[field])

  return row

fn render_model_list(admin, meta, req)
  query = request_query(req)

  page = parse_int(query.page, 1, 1)
  per_page = parse_int(query.per_page, meta.per_page, 1, 200)
  q = query.q
  sort = query.sort
  if type(sort) != "string" or sort == "" or not allowed_field(meta.list_fields, sort)
    sort = meta.default_sort

  dir = query.dir == "desc" ? "desc" : "asc"
  order_by = dir == "desc" ? "-" + sort : sort

  opts = {
    order_by = order_by,
    offset = (page - 1) * per_page,
    limit = per_page
  }

  count_opts = {}
  if type(q) == "string" and q.trim() != "" and #meta.search_fields > 0
    opts.any = {}
    count_opts.any = {}
    for field in meta.search_fields
      clause = {}
      clause[field + "__contains"] = q
      opts.any <+ clause
      count_opts.any <+ clause

  rows = nil
  total = 0
  try
    rows = meta.table.filter(opts)
    total = meta.table.count(count_opts)
  except e
    print("[admin.list] filter/count error model=" + str(meta.name) + " sort=" + str(sort) + " dir=" + str(dir) + " order_by=" + str(order_by) + " q=" + str(q) + " opts=" + str(opts))
    error(e)
  page_count = int((total + per_page - 1) / per_page)
  if page_count < 1
    page_count = 1

  model_path = admin.mount_path + "/" + meta.name
  parts = {}

  head_actions = html.link(model_path + "/new", "New " + meta.label, {class = "btn primary"})
  search_form = '<form method="GET">'
  search_form = search_form + html.input("q", q or "", {type = "text", placeholder = "search"})
  search_form = search_form + html.button("Filter", {class = "btn"})
  search_form = search_form + "</form>"

  top_panel = html.tag("div", {class = "toolbar"}, html.tag("h2", nil, html.text(meta.label)) + head_actions)
  top_panel = top_panel + html.tag("small", {class = "meta"}, "rows: " + str(total) + " | page " + str(page) + "/" + str(page_count))
  top_panel = top_panel + html.tag("div", {class = "toolbar"}, search_form)
  parts <+ html.tag("section", {class = "panel"}, top_panel)

  table_bits = {}
  head_cells = {}
  for field in meta.list_fields
    next_dir = "asc"
    if field == sort and dir == "asc"
      next_dir = "desc"
    qs = encode_query({
      q = q,
      sort = field,
      dir = next_dir,
      page = 1,
      per_page = per_page
    })
    head_cells <+ html.tag("th", nil, html.link(model_path + qs, field, {}))
  head_cells <+ html.tag("th", nil, "Actions")

  head_html = str("".join(head_cells))
  table_bits <+ string.format("<thead><tr>%s</tr></thead>", head_html)

  body_rows = {}
  for row in rows
    cells = {}
    for field in meta.list_fields
      cells <+ html.tag("td", nil, html.text(display_value(row[field])))

    id_raw = row.id
    edit_url = model_path + "/" + url.encode(str(id_raw)) + "/edit"
    del_url = model_path + "/" + url.encode(str(id_raw)) + "/delete"
    actions = html.link(edit_url, "Edit", {class = "btn"}) + " "
    actions = actions + string.format('<form class="inline" method="POST" action="%s">%s</form>', html.escape(del_url), html.button("Delete", {class = "btn danger"}))
    cells <+ html.tag("td", nil, actions)
    body_rows <+ string.format("<tr>%s</tr>", str("".join(cells)))

  table_bits <+ string.format("<tbody>%s</tbody>", str("".join(body_rows)))

  prev_link = ""
  next_link = ""
  if page > 1
    prev_link = html.link(model_path + encode_query({q = q, sort = sort, dir = dir, page = page - 1, per_page = per_page}), "Previous", {class = "btn"})
  if page < page_count
    next_link = html.link(model_path + encode_query({q = q, sort = sort, dir = dir, page = page + 1, per_page = per_page}), "Next", {class = "btn"})

  parts <+ html.tag("section", {class = "panel table-wrap"}, html.tag("table", nil, "".join(table_bits)))
  parts <+ html.tag("section", {class = "panel toolbar"}, prev_link + " " + next_link)

  return render_page(admin, meta.label, "".join(parts))

fn render_model_form(admin, meta, mode, row_data, error_text = nil)
  model_path = admin.mount_path + "/" + meta.name
  heading = mode == "new" ? "Create " + meta.label : "Edit " + meta.label
  action = mode == "new" ? model_path + "/new" : model_path + "/" + url.encode(str(row_data.id)) + "/edit"

  pieces = {}
  pieces <+ html.tag("h2", nil, html.text(heading))
  pieces <+ html.link(model_path, "Back to list", {class = "btn"})

  if error_text != nil and error_text != ""
    pieces <+ html.tag("p", {class = "error"}, html.text(error_text))

  form_bits = {'<form method="POST" action="' + html.escape(action) + '">'}
  for field in meta.form_fields
    form_bits <+ render_form_field(meta, field, row_data)
  form_bits <+ html.button(mode == "new" ? "Create" : "Save", {class = "btn primary"})
  form_bits <+ "</form>"
  pieces <+ "".join(form_bits)

  body = html.tag("section", {class = "panel"}, "".join(pieces))
  return render_page(admin, heading, body)

fn register_routes(admin)
  if admin.routes_registered
    return nil
  admin.routes_registered = true

  index_route = admin.app.get(admin.mount_path)
  index_route(fn()
    if #admin.models == 0
      body = html.tag("section", {class = "panel"}, html.tag("h2", nil, "Admin") + html.tag("p", nil, "No models registered."))
      return render_page(admin, "Admin", body)
    return redirect_response(admin.mount_path + "/" + admin.models[1].name)
  )

  list_route = admin.app.get(admin.mount_path + "/<model>")
  list_route(fn(model, req)
    meta = model_meta_for(admin, model)
    if meta == nil
      return render_not_found(admin, "Unknown model: " + model)
    return render_model_list(admin, meta, req)
  )

  new_get_route = admin.app.get(admin.mount_path + "/<model>/new")
  new_get_route(fn(model)
    meta = model_meta_for(admin, model)
    if meta == nil
      return render_not_found(admin, "Unknown model: " + model)
    return render_model_form(admin, meta, "new", {})
  )

  new_post_route = admin.app.post(admin.mount_path + "/<model>/new")
  new_post_route(fn(model, req)
    meta = model_meta_for(admin, model)
    if meta == nil
      return render_not_found(admin, "Unknown model: " + model)

    payload = request_data(req)
    display_payload = build_form_values(meta, payload)
    row = nil
    try
      row = form_to_row(meta, payload, nil)
      row.id = uuid.uid()
      meta.table.put(row)
    except e
      return render_model_form(admin, meta, "new", display_payload, str(e))

    return redirect_response(admin.mount_path + "/" + meta.name)
  )

  edit_get_route = admin.app.get(admin.mount_path + "/<model>/<id>/edit")
  edit_get_route(fn(model, id)
    meta = model_meta_for(admin, model)
    if meta == nil
      return render_not_found(admin, "Unknown model: " + model)

    row = meta.table.get(id)
    if row == nil
      return render_not_found(admin, "Unknown id: " + str(id))
    return render_model_form(admin, meta, "edit", row)
  )

  edit_post_route = admin.app.post(admin.mount_path + "/<model>/<id>/edit")
  edit_post_route(fn(model, id, req)
    meta = model_meta_for(admin, model)
    if meta == nil
      return render_not_found(admin, "Unknown model: " + model)

    current = meta.table.get(id)
    if current == nil
      return render_not_found(admin, "Unknown id: " + str(id))

    payload = request_data(req)
    display_payload = build_form_values(meta, payload, current)
    try
      updated = form_to_row(meta, payload, current)
      updated.id = current.id
      meta.table.put(updated)
    except e
      display_payload.id = current.id
      return render_model_form(admin, meta, "edit", display_payload, str(e))

    return redirect_response(admin.mount_path + "/" + meta.name)
  )

  delete_post_route = admin.app.post(admin.mount_path + "/<model>/<id>/delete")
  delete_post_route(fn(model, id)
    meta = model_meta_for(admin, model)
    if meta == nil
      return render_not_found(admin, "Unknown model: " + model)

    meta.table.delete(id)
    return redirect_response(admin.mount_path + "/" + meta.name)
  )

fn build_default_fields(schema)
  out = {}
  if type(schema) == "table" and type(schema.schema) == "table"
    for field, _ in schema.schema
      if field != "id"
        out <+ field
  i = 2
  while i <= #out
    current = out[i]
    j = i - 1
    while j >= 1 and str(current) < str(out[j])
      out[j + 1] = out[j]
      j = j - 1
    out[j + 1] = current
    i = i + 1
  return out

fn create_list_fields(form_fields, provided = nil)
  if type(provided) == "table" and #provided > 0
    return copy_list(provided)

  fields = {"id"}
  for name in form_fields
    fields <+ name
  return fields

fn new(app, db, opts = nil)
  if type(app) != "table"
    error("admin.new(app, db, opts=nil): app must be http_server app")
  if type(db) != "table"
    error("admin.new(app, db, opts=nil): db must be lib.db handle")

  options = opts or {}
  admin = {
    app = app,
    db = db,
    title = options.title or "Admin",
    mount_path = normalize_mount_path(options.mount_path or "/admin"),
    models = {},
    model_by_name = {},
    routes_registered = false
  }

  admin.register = fn(schema, model_opts = nil)
    if type(schema) != "table"
      error("admin.register(schema, opts=nil): schema must be Record model")

    table_proxy = db.create_table(schema)
    name = table_proxy.name
    form_fields = type(model_opts) == "table" and type(model_opts.form_fields) == "table" ? copy_list(model_opts.form_fields) : build_default_fields(schema)
    label = title_case(name)
    list_fields_override = nil
    default_sort = "id"
    per_page = 20
    field_types = {}
    search_fields = copy_list(form_fields)

    if type(model_opts) == "table"
      if type(model_opts.label) == "string" and model_opts.label != ""
        label = model_opts.label
      if type(model_opts.list_fields) == "table"
        list_fields_override = model_opts.list_fields
      if type(model_opts.search_fields) == "table"
        search_fields = copy_list(model_opts.search_fields)
      if type(model_opts.default_sort) == "string" and model_opts.default_sort != ""
        default_sort = model_opts.default_sort
      if type(model_opts.per_page) == "number"
        per_page = int(model_opts.per_page)
      if type(model_opts.field_types) == "table"
        field_types = model_opts.field_types

    meta = {
      name = name,
      label = label,
      schema = schema,
      table = table_proxy,
      form_fields = form_fields,
      list_fields = create_list_fields(form_fields, list_fields_override),
      search_fields = search_fields,
      default_sort = default_sort,
      per_page = per_page,
      field_types = field_types
    }

    admin.model_by_name[name] = meta

    replaced = false
    for i in 1..#admin.models
      if admin.models[i].name == name
        admin.models[i] = meta
        replaced = true
        break

    if not replaced
      admin.models <+ meta

    register_routes(admin)
    return admin

  admin.mount = fn()
    register_routes(admin)
    return admin

  return admin

return {
  new = new
}
