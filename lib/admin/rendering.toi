io = import io
string = import string
url = import url
template = import template
html = import lib.html
h = import lib.admin.helpers

fn read_layout_template()
  with io.open("lib/admin/layout.toi.tpl", "r") as f
    return f.read() or ""

fn read_styles()
  with io.open("lib/admin/admin.css", "r") as f
    return f.read() or ""

LAYOUT_TEMPLATE = read_layout_template()
STYLES = read_styles()
render_layout = template.compile(LAYOUT_TEMPLATE)

fn render_form_field(meta, field, row_data)
  field_label = h.title_case(field)
  kind = h.infer_field_kind(meta.schema, field, meta.field_types)
  value = row_data[field]

  if kind == "bool"
    attrs = {
      type = "checkbox",
      name = field,
      value = "true"
    }
    if value
      attrs.checked = true
    control = html.input(field, nil, attrs)
    return html.tag("label", {class = "field"}, control + " " + html.text(field_label))

  if kind == "textarea"
    control = html.textarea(field, h.display_value(value), {rows = 6})
    return html.tag("label", {class = "field"}, html.tag("span", nil, html.text(field_label)) + control)

  input_type = "text"
  attrs = {}
  if kind == "int"
    input_type = "number"
    attrs.step = "1"
  elif kind == "number"
    input_type = "number"
    attrs.step = "any"

  attrs.type = input_type
  control = html.input(field, h.display_value(value), attrs)
  return html.tag("label", {class = "field"}, html.tag("span", nil, html.text(field_label)) + control)

fn render_page(admin, page_title, body_html)
  nav_items = {}
  for meta in admin.models
    nav_items <+ {
      href = admin.mount_path + "/" + meta.name,
      label = meta.label
    }

  doc = render_layout({
    page_title = page_title,
    app_title = admin.title,
    styles = STYLES,
    nav_items = nav_items,
    body_html = body_html
  })
  return h.html_response(doc)

fn render_not_found(admin, msg = "Not Found")
  body = html.tag("section", {class = "panel"}, html.tag("h2", nil, "Admin") + html.tag("p", nil, html.text(msg)))
  return render_page(admin, "Admin", body)

fn render_model_list(admin, meta, req)
  query = h.request_query(req)

  page = h.parse_int(query.page, 1, 1)
  per_page = h.parse_int(query.per_page, meta.per_page, 1, 200)
  q = query.q
  sort = query.sort
  if type(sort) != "string" or sort == "" or not h.allowed_field(meta.list_fields, sort)
    sort = meta.default_sort

  dir = query.dir == "desc" ? "desc" : "asc"
  order_by = dir == "desc" ? "-" + sort : sort

  opts = {
    order_by = order_by,
    offset = (page - 1) * per_page,
    limit = per_page
  }

  count_opts = {}
  if type(q) == "string" and q.trim() != "" and #meta.search_fields > 0
    opts.any = {}
    count_opts.any = {}
    for field in meta.search_fields
      clause = {}
      clause[field + "__contains"] = q
      opts.any <+ clause
      count_opts.any <+ clause

  rows = nil
  total = 0
  try
    rows = meta.table.filter(opts)
    total = meta.table.count(count_opts)
  except e
    print("[admin.list] filter/count error model=" + str(meta.name) + " sort=" + str(sort) + " dir=" + str(dir) + " order_by=" + str(order_by) + " q=" + str(q) + " opts=" + str(opts))
    error(e)
  page_count = int((total + per_page - 1) / per_page)
  if page_count < 1
    page_count = 1

  model_path = admin.mount_path + "/" + meta.name
  parts = {}

  head_actions = html.link(model_path + "/new", "New " + meta.label, {class = "btn primary"})
  search_form = '<form method="GET">'
  search_form = search_form + html.input("q", q or "", {type = "text", placeholder = "search"})
  search_form = search_form + html.button("Filter", {class = "btn"})
  search_form = search_form + "</form>"

  top_panel = html.tag("div", {class = "toolbar"}, html.tag("h2", nil, html.text(meta.label)) + head_actions)
  top_panel = top_panel + html.tag("small", {class = "meta"}, "rows: " + str(total) + " | page " + str(page) + "/" + str(page_count))
  top_panel = top_panel + html.tag("div", {class = "toolbar"}, search_form)
  parts <+ html.tag("section", {class = "panel"}, top_panel)

  table_bits = {}
  head_cells = {}
  for field in meta.list_fields
    next_dir = "asc"
    if field == sort and dir == "asc"
      next_dir = "desc"
    qs = h.encode_query({
      q = q,
      sort = field,
      dir = next_dir,
      page = 1,
      per_page = per_page
    })
    head_cells <+ html.tag("th", nil, html.link(model_path + qs, field, {}))
  head_cells <+ html.tag("th", nil, "Actions")

  head_html = str("".join(head_cells))
  table_bits <+ string.format("<thead><tr>%s</tr></thead>", head_html)

  body_rows = {}
  for row in rows
    cells = {}
    for field in meta.list_fields
      cells <+ html.tag("td", nil, html.text(h.display_value(row[field])))

    id_raw = row.id
    edit_url = model_path + "/" + url.encode(str(id_raw)) + "/edit"
    del_url = model_path + "/" + url.encode(str(id_raw)) + "/delete"
    actions = html.link(edit_url, "Edit", {role = "button"}) + " "
    actions = actions + string.format('<form class="inline" method="POST" action="%s">%s</form>', html.escape(del_url), html.button("Delete", {class = "btn danger"}))
    cells <+ html.tag("td", nil, actions)
    body_rows <+ string.format("<tr>%s</tr>", str("".join(cells)))

  table_bits <+ string.format("<tbody>%s</tbody>", str("".join(body_rows)))

  prev_link = ""
  next_link = ""
  if page > 1
    prev_link = html.link(model_path + h.encode_query({q = q, sort = sort, dir = dir, page = page - 1, per_page = per_page}), "Previous", {class = "btn"})
  if page < page_count
    next_link = html.link(model_path + h.encode_query({q = q, sort = sort, dir = dir, page = page + 1, per_page = per_page}), "Next", {class = "btn"})

  parts <+ html.tag("section", {class = "panel"}, html.tag("table", nil, "".join(table_bits)))
  parts <+ html.tag("section", {id = "toolbar"}, prev_link + " " + next_link)

  return render_page(admin, meta.label, "".join(parts))

fn render_model_form(admin, meta, mode, row_data, error_text = nil)
  model_path = admin.mount_path + "/" + meta.name
  heading = mode == "new" ? "Create " + meta.label : "Edit " + meta.label
  action = mode == "new" ? model_path + "/new" : model_path + "/" + url.encode(str(row_data.id)) + "/edit"

  pieces = {}
  pieces <+ html.tag("h2", nil, html.text(heading))
  pieces <+ html.link(model_path, "Back to list", {class = "btn"})

  if error_text != nil and error_text != ""
    pieces <+ html.tag("p", {class = "error"}, html.text(error_text))

  form_bits = {'<form method="POST" action="' + html.escape(action) + '">'}
  for field in meta.form_fields
    form_bits <+ render_form_field(meta, field, row_data)
  form_bits <+ html.button(mode == "new" ? "Create" : "Save", {class = "btn primary"})
  form_bits <+ "</form>"
  pieces <+ "".join(form_bits)

  body = html.tag("section", {class = "panel"}, "".join(pieces))
  return render_page(admin, heading, body)

return {
  render_form_field = render_form_field,
  render_page = render_page,
  render_not_found = render_not_found,
  render_model_list = render_model_list,
  render_model_form = render_model_form
}
