string = import string
table = import table
socket = import socket
http = import http
coroutine = import coroutine
os = import os
selector = import lib.selector
time = import time

thread = nil
try
  thread = import thread
except e
  thread = nil

Transport = {}
DEBUG_ERRORS = os.getenv("HTTP_SERVER_DEBUG_ERRORS") == "1"

fn safe_str(v)
  try
    return str(v)
  except e
    return "<unprintable>"

fn set_socket_timeout(sock)
  -- Idle read timeout for speculative/browser keep-alive sockets.
  sock.settimeout(sock, 10)

fn set_nonblocking(sock)
  sock.settimeout(sock, 0)

fn ensure_tls_on_client(server, client)
  if server == nil or not server.ssl
    return true
  ok, err = client.tls_server(client, server.ssl_cert, server.ssl_key)
  if ok
    return true
  if err
    return err
  if ok
    return ok
  return "tls_server failed"

fn find_connection_index(connections, sock)
  return table.find_index(connections, sock, fn(c) return c.sock)

fn close_connection(conn)
  if conn.sock
    conn.sock.close(conn.sock)
  conn.sock = nil
  conn.coro = nil

fn close_server_socket(server)
  if server == nil or server.socket == nil
    return nil
  try
    server.socket.close(server.socket)
  except e
    nil

fn update_connection_state(server, conn, mode)
  status = coroutine.status(conn.coro)
  match status
    case "dead"
      conn.mode = "dead"
    else
      conn.mode = mode or "read"

fn is_timeout_error(err)
  if err == nil
    return false
  if err == "timeout"
    return true
  lower_err = str(err).lower()
  return lower_err.find("timeout") != nil

fn is_closed_error(err)
  if err == nil
    return false
  lower_err = str(err).lower()
  return lower_err.find("closed") != nil or lower_err.find("reset") != nil

fn is_wouldblock_error(err)
  if err == nil
    return false
  lower_err = str(err).lower()
  return lower_err.find("would block") != nil or lower_err.find("temporarily unavailable") != nil or lower_err.find("again") != nil

fn safe_selector_wait(sel, timeout)
  try
    ready_read, ready_write = selector.wait(sel, timeout)
    return {read = ready_read, write = ready_write}, nil
  except e
    return nil, safe_str(e)

fn send_all(server, client, data)
  if not istype(data, "string")
    data = str(data)
  if data == ""
    return true

  total = #data
  sent_total = 0
  retries = 0
  while sent_total < total
    chunk = data.sub(sent_total + 1)
    sent, send_err = client.send(client, chunk)
    if istype(sent, "number")
      if sent <= 0
        return false
      sent_total = sent_total + sent
      retries = 0
      continue

    if send_err and (is_timeout_error(send_err) or is_wouldblock_error(send_err))
      retries = retries + 1
      if retries > 2000
        if DEBUG_ERRORS
          print("[http_server] send timeout retries exceeded")
        return false
      if thread and thread.sleep
        thread.sleep(0.001)
      continue

    if DEBUG_ERRORS
      print("[http_server] send error: " + safe_str(send_err))
    return false

  if DEBUG_ERRORS
    print("[http_server] sent bytes=" + str(total))
  return true

fn safe_accept(server_sock)
  try
    client, ip_or_err = server_sock.accept(server_sock)
    if client == nil
      if ip_or_err == nil
        return nil, nil, "would block"
      return nil, nil, safe_str(ip_or_err)
    return client, ip_or_err, nil
  except e
    return nil, nil, safe_str(e)

fn accept_pending_connections(server, on_client, on_client_state)
  accepted = 0
  while true
    client, ip, accept_err = safe_accept(server.socket)
    if accept_err != nil
      if is_timeout_error(accept_err) or is_wouldblock_error(accept_err)
        return accepted
      if DEBUG_ERRORS
        print("[http_server] accept error: " + safe_str(accept_err))
      return accepted
    if client == nil
      return accepted
    accepted = accepted + 1
    if DEBUG_ERRORS
      print("[http_server] accepted connection from " + safe_str(ip))
    on_client(on_client_state, client)

fn upsert_response_header(raw_response, key, value)
  if not istype(raw_response, "string")
    return raw_response

  head_start, head_end = raw_response.find("\r\n\r\n")
  if head_start == nil
    return raw_response

  head = raw_response.sub(1, head_start - 1)
  body = raw_response.sub(head_end + 1)
  lines = head.split("\r\n")
  if #lines == 0
    return raw_response

  out = {}
  out <+ lines[1]
  target = key.lower()
  replaced = false
  if #lines > 1
    for i in 2..#lines
      line = lines[i]
      colon_i = line.find(":")
      if colon_i and colon_i > 1
        name = line.sub(1, colon_i - 1).trim().lower()
        if name == target
          if not replaced
            out <+ (key + ": " + value)
            replaced = true
        else
          out <+ line
      else
        out <+ line

  if not replaced
    out <+ (key + ": " + value)

  return table.concat(out, "\r\n") + "\r\n\r\n" + body

fn decorate_connection_headers(raw_response, keep_alive)
  try
    if keep_alive
      return upsert_response_header(raw_response, "Connection", "keep-alive")
    return upsert_response_header(raw_response, "Connection", "close")
  except e
    return raw_response

fn is_stream_response(res)
  return istype(res, "table") and res.__stream and res.stream != nil

fn send_chunked_stream(server, client, stream_res, keep_alive)
  status = stream_res.status or 200
  headers = stream_res.headers
  if not istype(headers, "table")
    headers = {}
  headers["Transfer-Encoding"] = "chunked"
  headers["Content-Length"] = nil
  headers["content-length"] = nil

  head = http.response(status, headers, "")
  head = decorate_connection_headers(head, keep_alive)
  if not send_all(server, client, head)
    return false

  for chunk in stream_res.stream
    if should_force_close(server)
      return false
    if chunk == nil
      continue
    data = chunk
    if not istype(data, "string")
      data = str(data)
    if data != ""
      frame = string.format("%x\r\n%s\r\n", #data, data)
      if not send_all(server, client, frame)
        return false

  return send_all(server, client, "0\r\n\r\n")

fn should_force_close(server)
  if server == nil or not istype(server, "table")
    return false
  if not server.stop_requested
    return false
  if server.stop_deadline == nil
    return false
  if os.clock() >= server.stop_deadline
    server.force_close = true
    return true
  return server.force_close

fn keep_alive_request(req)
  version = req.version or ""
  headers = req.headers or {}
  connection = headers.connection or ""
  has_close = false
  has_keep_alive = false
  for option in connection.split(",")
    option = option.trim().lower()
    if option == "close"
      has_close = true
    elif option == "keep-alive"
      has_keep_alive = true

  if has_close
    return false
  if version == "HTTP/1.1"
    return true
  if version == "HTTP/1.0"
    return has_keep_alive
  return false

fn recv_next_chunk(server, client)
  while true
    if should_force_close(server)
      return nil, "closed", client
    if client == nil or not istype(client, "userdata")
      return nil, "closed", client

    data, err = client.recv(client, 4096)
    if data and #data > 0
      return data, nil, client

    if data and #data == 0
      return nil, "closed", client

    if err and (is_timeout_error(err) or is_wouldblock_error(err))
      return nil, "timeout", client

    if err == nil
      return nil, "closed", client
    return nil, err, client

fn handle_connection(server, client)
  if not istype(server, "table") and istype(client, "table")
    tmp = server
    server = client
    client = tmp
  if not istype(server, "table") or not istype(client, "userdata")
    return "done"
  server.active_connections = server.active_connections + 1
  buffer = ""
  keep_running = true
  fallback_500 = "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Length: 21\r\n\r\nInternal Server Error"

  while keep_running
    if should_force_close(server)
      break

    req = nil
    bad_request = false

    while req == nil and not bad_request
      if #buffer > 0
        parsed = http.parse(buffer)
        if parsed == false
          bad_request = true
          break
        if parsed != nil
          req = parsed
          if DEBUG_ERRORS
            print("[http_server] parsed request " + safe_str(req.method) + " " + safe_str(req.path))
          break

      chunk, err, next_client = recv_next_chunk(server, client)
      client = next_client or client
      if chunk == nil
        if is_closed_error(err) or err == "closed" or is_timeout_error(err) or is_wouldblock_error(err)
          keep_running = false
        else
          keep_running = false
        break
      buffer = buffer + chunk

    if not keep_running
      break

    if bad_request
      server.request_count = server.request_count + 1
      try
        send_all(server, client, decorate_connection_headers(http.response(400, nil, "Bad Request"), false))
      except e
        nil
      break

    consumed = req.consumed
    if not istype(consumed, "number") or consumed < 0
      consumed = #buffer
    if consumed < #buffer
      buffer = buffer.sub(consumed + 1)
    else
      buffer = ""
    if DEBUG_ERRORS
      print("[http_server] consumed=" + str(consumed) + " remaining=" + str(#buffer))

    request_keep_alive = keep_alive_request(req)
    if not server.keep_alive
      request_keep_alive = false
    if server.stop_requested or should_force_close(server)
      request_keep_alive = false

    phase = "handler"
    try
      res = server.handler(req)
      server.request_count = server.request_count + 1
      phase = "normalize"
      normalized = server.normalize_response(res)
      if is_stream_response(normalized)
        phase = "stream_send"
        ok = send_chunked_stream(server, client, normalized, request_keep_alive)
        if not ok
          break
      else
        phase = "send"
        payload = normalized
        try
          payload = decorate_connection_headers(normalized, request_keep_alive)
        except e
          payload = normalized
        if not send_all(server, client, payload)
          if DEBUG_ERRORS
            print("[http_server] send_all failed for " + safe_str(req.method) + " " + safe_str(req.path))
          break
    except e
      server.request_count = server.request_count + 1
      if DEBUG_ERRORS
        p = req != nil ? (req.path or "?") : "?"
        m = req != nil ? (req.method or "?") : "?"
        print("[http_server] request error (" + phase + ") " + safe_str(m) + " " + safe_str(p) + ": " + safe_str(e))
      payload = fallback_500
      try
        candidate = decorate_connection_headers(http.response(500, nil, "Internal Server Error"), false)
        if istype(candidate, "string")
          payload = candidate
      except inner
        payload = fallback_500
      try
        send_all(server, client, payload)
      except send_err
        nil
      break

    if not request_keep_alive
      if DEBUG_ERRORS
        print("[http_server] closing connection after response")
      break

  try
    client.close(client)
  except e
    nil
  if DEBUG_ERRORS
    print("[http_server] connection closed")
  if server.active_connections > 0
    server.active_connections = server.active_connections - 1
  return "done"

fn start_connection(server, client)
  co = coroutine.create(handle_connection)
  conn = {sock = client, coro = co, mode = "read"}
  ok, yielded, mode = coroutine.resume(co, server, client)
  if mode == nil
    mode = yielded
  if not ok and DEBUG_ERRORS
    print("[http_server] initial connection coroutine error: " + safe_str(mode))
  update_connection_state(server, conn, mode)
  return conn

fn compact_connections(connections)
  active = {}
  for conn in connections
    if conn.mode != "dead"
      active <+ conn
    else
      close_connection(conn)
  return active

fn run_maintenance(server, last_gc_req)
  if server.gc_every_requests and server.gc_every_requests > 0
    if server.request_count > 0 and server.request_count % server.gc_every_requests == 0 and server.request_count != last_gc_req
      gc
      last_gc_req = server.request_count
      if server.trim_after_gc and os.trim
        os.trim()

  return last_gc_req

fn accept_coroutine_client(state, client)
  server = state.server
  connections = state.connections
  tls_err = ensure_tls_on_client(server, client)
  if tls_err != true
    try
      client.close(client)
    except e
      nil
    return nil
  set_socket_timeout(client)
  conn = start_connection(server, client)
  if conn.mode != "dead"
    connections <+ conn
    return nil
  close_connection(conn)
  return nil

fn dispatch_worker_client(state, client)
  server = state.server
  queues = state.queues
  worker_state = state.worker_state
  worker_count = state.worker_count
  tls_err = ensure_tls_on_client(server, client)
  if tls_err != true
    try
      client.close(client)
    except e
      nil
    return nil
  set_socket_timeout(client)
  target = queues[worker_state.next_worker]
  worker_state.next_worker = worker_state.next_worker + 1
  if worker_state.next_worker > worker_count
    worker_state.next_worker = 1
  ok = target.send(target, client)
  if not ok
    client.close(client)
  return nil

fn poll_close_connection(server, conn)
  if conn.sock
    try
      conn.sock.close(conn.sock)
    except e
      nil
    conn.sock = nil
  if conn.counted_active
    if server.active_connections > 0
      server.active_connections = server.active_connections - 1
    conn.counted_active = false
  conn.mode = "dead"

fn accept_poll_client(state, client)
  server = state.server
  set_nonblocking(client)
  server.active_connections = server.active_connections + 1
  state.connections <+ {
    sock = client,
    buffer = "",
    response = nil,
    write_offset = 0,
    keep_alive = false,
    mode = "read",
    counted_active = true
  }

fn poll_error_response(conn, status, body)
  conn.response = decorate_connection_headers(http.response(status, nil, body), false)
  conn.write_offset = 0
  conn.keep_alive = false
  conn.mode = "write"

fn poll_handler_error(server, conn, err)
  server.request_count = server.request_count + 1
  if DEBUG_ERRORS
    print("[http_server] request handler error: " + safe_str(err))
  conn.handler = nil
  conn.response = decorate_connection_headers(http.response(500, nil, "Internal Server Error"), false)
  conn.write_offset = 0
  conn.keep_alive = false
  conn.mode = "write"

fn resume_poll_handler(server, conn, req = nil)
  ok = nil
  result = nil
  delay = nil
  if req
    ok, result, delay = coroutine.resume(conn.handler, req)
  else
    ok, result, delay = coroutine.resume(conn.handler)
  if not ok
    poll_handler_error(server, conn, result)
    return nil

  if coroutine.status(conn.handler) != "dead"
    if result == "sleep" and istype(delay, "number")
      if delay < 0
        delay = 0
      conn.wake_at = time.nanos() / 1000000000 + delay
      conn.mode = "sleep"
      return nil
    if (result == "io_read" or result == "io_write") and delay
      conn.wait_sock = delay
      conn.mode = result
      return nil
    poll_handler_error(server, conn, "handler yielded unsupported command " + safe_str(result))
    return nil

  conn.handler = nil
  conn.wake_at = nil
  conn.wait_sock = nil
  server.request_count = server.request_count + 1
  normalized = server.normalize_response(result)
  if is_stream_response(normalized)
    -- Stream iteration and its chunk writes remain synchronous.
    if send_chunked_stream(server, conn.sock, normalized, conn.keep_alive)
      conn.mode = conn.keep_alive ? "read" : "dead"
    else
      conn.mode = "dead"
  else
    conn.response = decorate_connection_headers(normalized, conn.keep_alive)
    conn.write_offset = 0
    conn.mode = "write"

fn prepare_poll_response(server, conn, req)
  keep_alive = keep_alive_request(req)
  if not server.keep_alive or server.stop_requested or should_force_close(server)
    keep_alive = false
  conn.keep_alive = keep_alive

  if server.coroutine_handlers
    conn.handler = coroutine.create(server.handler)
    resume_poll_handler(server, conn, req)
    return nil

  phase = "handler"
  try
    res = server.handler(req)
    server.request_count = server.request_count + 1
    phase = "normalize"
    normalized = server.normalize_response(res)
    if is_stream_response(normalized)
      if send_chunked_stream(server, conn.sock, normalized, keep_alive)
        conn.mode = keep_alive ? "read" : "dead"
      else
        conn.mode = "dead"
    else
      conn.response = decorate_connection_headers(normalized, keep_alive)
      conn.write_offset = 0
      conn.mode = "write"
  except e
    if DEBUG_ERRORS
      print("[http_server] request error (" + phase + "): " + safe_str(e))
    poll_handler_error(server, conn, e)

fn advance_poll_connection(server, conn)
  if conn.mode == "read"
    data, err = conn.sock.recv(conn.sock, 4096)
    if data and #data > 0
      conn.buffer = conn.buffer + data
      parsed = http.parse(conn.buffer)
      if parsed == false
        server.request_count = server.request_count + 1
        poll_error_response(conn, 400, "Bad Request")
      elif parsed != nil
        consumed = parsed.consumed
        if not istype(consumed, "number") or consumed < 0
          consumed = #conn.buffer
        if consumed < #conn.buffer
          conn.buffer = conn.buffer.sub(consumed + 1)
        else
          conn.buffer = ""
        prepare_poll_response(server, conn, parsed)
      return nil
    if err and (is_timeout_error(err) or is_wouldblock_error(err))
      return nil
    conn.mode = "dead"
    return nil

  if conn.mode == "write"
    if not istype(conn.response, "string")
      conn.mode = "dead"
      return nil
    chunk = conn.response.sub(conn.write_offset + 1)
    sent, err = conn.sock.send(conn.sock, chunk)
    if istype(sent, "number") and sent > 0
      conn.write_offset = conn.write_offset + sent
      if conn.write_offset >= #conn.response
        conn.response = nil
        conn.write_offset = 0
        conn.mode = conn.keep_alive ? "read" : "dead"
      return nil
    if err and (is_timeout_error(err) or is_wouldblock_error(err))
      return nil
    conn.mode = "dead"

fn compact_poll_connections(server, connections)
  active = {}
  for conn in connections
    if conn.mode == "dead"
      poll_close_connection(server, conn)
    else
      active <+ conn
  return active

fn run_poll_loop(server)
  connections = {}
  last_gc_req = 0
  listener_closed = false
  server.socket.settimeout(server.socket, 0)
  while true
    accepting = not server.stop_requested
    if server.stop_requested and not listener_closed
      close_server_socket(server)
      listener_closed = true
    if should_force_close(server)
      for conn in connections
        poll_close_connection(server, conn)
      connections = {}
      break
    if not accepting and #connections == 0
      break

    now = time.nanos() / 1000000000
    next_wake = nil
    for conn in connections
      if conn.mode == "sleep"
        if conn.wake_at <= now
          resume_poll_handler(server, conn)
        elif next_wake == nil or conn.wake_at < next_wake
          next_wake = conn.wake_at

    sel = selector.new()
    if accepting
      selector.add_read(sel, server.socket)
    for conn in connections
      if conn.mode == "read"
        selector.add_read(sel, conn.sock)
      elif conn.mode == "write"
        selector.add_write(sel, conn.sock)
      elif conn.mode == "io_read"
        selector.add_read(sel, conn.wait_sock)
      elif conn.mode == "io_write"
        selector.add_write(sel, conn.wait_sock)
    wait_timeout = server.worker_select_timeout or 0.05
    if next_wake
      until_wake = next_wake - now
      if until_wake < wait_timeout
        wait_timeout = until_wake
    if wait_timeout < 0
      wait_timeout = 0
    ready, wait_err = safe_selector_wait(sel, wait_timeout)
    if ready == nil
      if DEBUG_ERRORS
        print("[http_server] selector wait failed: " + safe_str(wait_err))
      continue
    if accepting and ready.read has server.socket
      accept_pending_connections(server, accept_poll_client, {server = server, connections = connections})
    for conn in connections
      if conn.mode == "read" and ready.read has conn.sock
        advance_poll_connection(server, conn)
      elif conn.mode == "write" and ready.write has conn.sock
        advance_poll_connection(server, conn)
      elif conn.mode == "io_read" and ready.read has conn.wait_sock
        resume_poll_handler(server, conn)
      elif conn.mode == "io_write" and ready.write has conn.wait_sock
        resume_poll_handler(server, conn)
    connections = compact_poll_connections(server, connections)
    last_gc_req = run_maintenance(server, last_gc_req)
    if thread
      thread.yield()
  for conn in connections
    poll_close_connection(server, conn)
  return "stopped"

fn run_blocking_coroutine_loop(server)
  connections = {}
  last_gc_req = 0

  accepting = true
  while true
    if server.stop_requested and accepting
      close_server_socket(server)
      accepting = false

    if should_force_close(server)
      for conn in connections
        close_connection(conn)
      connections = {}
      break

    if not accepting and #connections == 0
      break

    accepted = 0
    if accepting
      accepted = accept_pending_connections(server, accept_coroutine_client, {server = server, connections = connections})

    resumed = 0
    for conn in connections
      if conn.mode == "read"
        ok, yielded, mode = coroutine.resume(conn.coro, conn.sock)
        if mode == nil
          mode = yielded
        if not ok and DEBUG_ERRORS
          print("[http_server] connection coroutine error: " + safe_str(mode))
        update_connection_state(server, conn, mode)
        resumed = resumed + 1

    connections = compact_connections(connections)
    last_gc_req = run_maintenance(server, last_gc_req)
    if accepted == 0 and resumed == 0
      if thread and thread.sleep
        thread.sleep(0.001)
    if thread
      thread.yield()

  for conn in connections
    close_connection(conn)
  return "stopped"

fn run_worker_loop(server, queue, select_timeout)
  connections = {}

  while true
    got_new = false
    while true
      if should_force_close(server)
        for conn in connections
          close_connection(conn)
        return "stopped"
      item, ok = queue.tryrecv(queue)
      if not ok
        break
      got_new = true
      if item == "__stop__"
        for conn in connections
          close_connection(conn)
        return "stopped"

      conn = start_connection(server, item)
      if conn.mode != "dead"
        connections <+ conn
      else
        close_connection(conn)

    if #connections == 0 and not got_new
      if should_force_close(server)
        return "stopped"
      item = queue.recv(queue)
      if item == nil or item == "__stop__"
        return "stopped"
      conn = start_connection(server, item)
      if conn.mode != "dead"
        connections <+ conn
      else
        close_connection(conn)

    resumed = 0
    for conn in connections
      if conn.mode == "read"
        ok, yielded, mode = coroutine.resume(conn.coro, conn.sock)
        if mode == nil
          mode = yielded
        if not ok and DEBUG_ERRORS
          print("[http_server] worker connection coroutine error: " + safe_str(mode))
        update_connection_state(server, conn, mode)
        resumed = resumed + 1

    if resumed == 0 and not got_new
      thread.sleep(select_timeout)

    connections = compact_connections(connections)
    thread.yield()

fn run_threaded_loop(server)
  worker_count = int(server.worker_threads)
  if worker_count < 1
    return run_blocking_coroutine_loop(server)
  if thread == nil
    print "thread module unavailable; using coroutine loop"
    return run_blocking_coroutine_loop(server)

  queues = {}
  workers = {}
  for i in 1..worker_count
    q = thread.channel(server.worker_queue_capacity)
    queues[i] = q
    workers[i] = thread.spawn(run_worker_loop, server, q, server.worker_select_timeout)

  worker_state = {next_worker = 1}
  last_gc_req = 0
  accepting = true
  while true
    if server.stop_requested and accepting
      close_server_socket(server)
      accepting = false

    if should_force_close(server)
      break
    if not accepting and server.active_connections <= 0
      break

    if accepting
      accepted = accept_pending_connections(server, dispatch_worker_client, {server = server, queues = queues, worker_state = worker_state, worker_count = worker_count})
      if accepted == 0
        thread.sleep(0.01)
    else
      thread.sleep(0.01)

    last_gc_req = run_maintenance(server, last_gc_req)
    thread.yield()

  for q in queues
    q.send(q, "__stop__")

  for worker in workers
    thread.join(worker)

  return "stopped"

Transport.run = fn(self, server_override = nil)
  server = server_override or self
  if server.running
    return false
  server.stop_requested = false
  server.stop_deadline = nil
  server.force_close = false
  server.active_connections = 0
  if server.ssl and socket.tls_available and socket.tls_available() != true
    error("http_server ssl=true but TLS is unavailable in this build")
  server.socket.bind(server.socket, server.host, server.port)
  server.socket.listen(server.socket, 128)
  if server.worker_threads and server.worker_threads > 0 or server.ssl
    server.socket.settimeout(server.socket, 0.01)
  else
    server.socket.settimeout(server.socket, 0)
  server.running = true

  scheme = "HTTP"
  if server.ssl
    scheme = "HTTPS"
  print(scheme + " Server running on " + server.host + ":" + str(server.port))

  out = nil
  try
    if server.worker_threads and server.worker_threads > 0
      out = run_threaded_loop(server)
    elif server.ssl
      out = run_blocking_coroutine_loop(server)
    else
      out = run_poll_loop(server)
  finally
    server.running = false
    close_server_socket(server)

  return out

return Transport
