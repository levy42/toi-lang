string = import string
table = import table
socket = import socket
http = import http
coroutine = import coroutine
os = import os
selector = import lib.selector

thread = nil
try
  thread = import thread
except e
  thread = nil

Transport = {}
DEBUG_ERRORS = os.getenv("HTTP_SERVER_DEBUG_ERRORS") == "1"

fn safe_str(v)
  try
    return str(v)
  except e
    return "<unprintable>"

fn set_nonblocking(sock)
  -- Idle read timeout for speculative/browser keep-alive sockets.
  sock.settimeout(sock, 10)

fn ensure_tls_on_client(server, client)
  if server == nil or not server.ssl
    return true
  ok, err = client.tls_server(client, server.ssl_cert, server.ssl_key)
  if ok
    return true
  if err
    return err
  if ok
    return ok
  return "tls_server failed"

fn find_connection_index(connections, sock)
  return table.find_index(connections, sock, fn(c) return c.sock)

fn close_connection(conn)
  if conn.sock
    conn.sock.close(conn.sock)
  conn.sock = nil
  conn.coro = nil

fn close_server_socket(server)
  if server == nil or server.socket == nil
    return nil
  try
    server.socket.close(server.socket)
  except e
    nil

fn update_connection_state(server, conn, mode)
  status = coroutine.status(conn.coro)
  match status
    case "dead"
      conn.mode = "dead"
    else
      conn.mode = mode or "read"

fn is_timeout_error(err)
  if err == nil
    return false
  if err == "timeout"
    return true
  lower_err = str(err).lower()
  return lower_err.find("timeout") != nil

fn is_closed_error(err)
  if err == nil
    return false
  lower_err = str(err).lower()
  return lower_err.find("closed") != nil or lower_err.find("reset") != nil

fn is_wouldblock_error(err)
  if err == nil
    return false
  lower_err = str(err).lower()
  return lower_err.find("would block") != nil or lower_err.find("temporarily unavailable") != nil or lower_err.find("again") != nil

fn safe_selector_wait(sel, timeout)
  try
    ready_read, ready_write = selector.wait(sel, timeout)
    return {read = ready_read, write = ready_write}, nil
  except e
    return nil, safe_str(e)

fn send_all(server, client, data)
  if not istype(data, "string")
    data = str(data)
  if data == ""
    return true

  total = #data
  sent_total = 0
  retries = 0
  while sent_total < total
    chunk = data.sub(sent_total + 1)
    sent, send_err = client.send(client, chunk)
    if istype(sent, "number")
      if sent <= 0
        return false
      sent_total = sent_total + sent
      retries = 0
      continue

    if send_err and (is_timeout_error(send_err) or is_wouldblock_error(send_err))
      retries = retries + 1
      if retries > 2000
        if DEBUG_ERRORS
          print("[http_server] send timeout retries exceeded")
        return false
      if thread and thread.sleep
        thread.sleep(0.001)
      continue

    if DEBUG_ERRORS
      print("[http_server] send error: " + safe_str(send_err))
    return false

  if DEBUG_ERRORS
    print("[http_server] sent bytes=" + str(total))
  return true

fn safe_accept(server_sock)
  try
    client, ip_or_err = server_sock.accept(server_sock)
    if client == nil
      if ip_or_err == nil
        return nil, nil, "would block"
      return nil, nil, safe_str(ip_or_err)
    return client, ip_or_err, nil
  except e
    return nil, nil, safe_str(e)

fn accept_pending_connections(server, on_client)
  accepted = 0
  while true
    client, ip, accept_err = safe_accept(server.socket)
    if accept_err != nil
      if is_timeout_error(accept_err) or is_wouldblock_error(accept_err)
        return accepted
      if DEBUG_ERRORS
        print("[http_server] accept error: " + safe_str(accept_err))
      return accepted
    if client == nil
      return accepted
    accepted = accepted + 1
    if DEBUG_ERRORS
      print("[http_server] accepted connection from " + safe_str(ip))
    on_client(client)

fn upsert_response_header(raw_response, key, value)
  if not istype(raw_response, "string")
    return raw_response

  head_i = raw_response.find("\r\n\r\n")
  if head_i == nil
    return raw_response

  -- string.find returns the start index in this runtime, so compute the
  -- separator end explicitly instead of relying on a second return value.
  head_end = head_i + 3
  head = raw_response.sub(1, head_i - 1)
  body = raw_response.sub(head_end + 1)
  lines = head.split("\r\n")
  if #lines == 0
    return raw_response

  out = {}
  out <+ lines[1]
  target = key.lower()
  replaced = false
  if #lines > 1
    for i in 2..#lines
      line = lines[i]
      colon_i = line.find(":")
      if colon_i and colon_i > 1
        name = line.sub(1, colon_i - 1).trim().lower()
        if name == target
          if not replaced
            out <+ key + ": " + value
            replaced = true
        else
          out <+ line
      else
        out <+ line

  if not replaced
    out <+ key + ": " + value

  return table.concat(out, "\r\n") + "\r\n\r\n" + body

fn decorate_connection_headers(raw_response, keep_alive)
  try
    if keep_alive
      return upsert_response_header(raw_response, "Connection", "keep-alive")
    return upsert_response_header(raw_response, "Connection", "close")
  except e
    return raw_response

fn is_stream_response(res)
  return istype(res, "table") and res.__stream and res.stream != nil

fn send_chunked_stream(server, client, stream_res, keep_alive)
  status = stream_res.status or 200
  headers = stream_res.headers
  if not istype(headers, "table")
    headers = {}
  headers["Transfer-Encoding"] = "chunked"
  headers["Content-Length"] = nil
  headers["content-length"] = nil

  head = http.response(status, headers, "")
  head = decorate_connection_headers(head, keep_alive)
  if not send_all(server, client, head)
    return false

  for chunk in stream_res.stream
    if should_force_close(server)
      return false
    if chunk == nil
      continue
    data = chunk
    if not istype(data, "string")
      data = str(data)
    if data != ""
      frame = string.format("%x\r\n%s\r\n", #data, data)
      if not send_all(server, client, frame)
        return false

  return send_all(server, client, "0\r\n\r\n")

fn should_force_close(server)
  if server == nil or not istype(server, "table")
    return false
  if not server.stop_requested
    return false
  if server.stop_deadline == nil
    return false
  if os.clock() >= server.stop_deadline
    server.force_close = true
    return true
  return server.force_close

fn keep_alive_request(req)
  -- Temporary safety switch: disable keep-alive until persistent-connection
  -- edge cases are fully fixed.
  return false

fn recv_next_chunk(server, client)
  while true
    if should_force_close(server)
      return nil, "closed", client
    if client == nil or not istype(client, "userdata")
      return nil, "closed", client

    data, err = client.recv(client, 4096)
    if data and #data > 0
      return data, nil, client

    if data and #data == 0
      return nil, "closed", client

    if err and (is_timeout_error(err) or is_wouldblock_error(err))
      return nil, "timeout", client

    if err == nil
      return nil, "closed", client
    return nil, err, client

fn handle_connection(server, client)
  if not istype(server, "table") and istype(client, "table")
    tmp = server
    server = client
    client = tmp
  if not istype(server, "table") or not istype(client, "userdata")
    return "done"
  server.active_connections = server.active_connections + 1
  buffer = ""
  keep_running = true
  fallback_500 = "HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Length: 21\r\n\r\nInternal Server Error"

  while keep_running
    if should_force_close(server)
      break

    req = nil
    bad_request = false

    while req == nil and not bad_request
      if #buffer > 0
        parsed = http.parse(buffer)
        if parsed == false
          bad_request = true
          break
        if parsed != nil
          req = parsed
          if DEBUG_ERRORS
            print("[http_server] parsed request " + safe_str(req.method) + " " + safe_str(req.path))
          break

      chunk, err, next_client = recv_next_chunk(server, client)
      client = next_client or client
      if chunk == nil
        if is_closed_error(err) or err == "closed" or is_timeout_error(err) or is_wouldblock_error(err)
          keep_running = false
        else
          keep_running = false
        break
      buffer = buffer + chunk

    if not keep_running
      break

    if bad_request
      server.request_count = server.request_count + 1
      try
        send_all(server, client, decorate_connection_headers(http.response(400, nil, "Bad Request"), false))
      except e
        nil
      break

    consumed = req.consumed
    if not istype(consumed, "number") or consumed < 0
      consumed = #buffer
    if consumed < #buffer
      buffer = buffer.sub(consumed + 1)
    else
      buffer = ""
    if DEBUG_ERRORS
      print("[http_server] consumed=" + str(consumed) + " remaining=" + str(#buffer))

    request_keep_alive = keep_alive_request(req)
    if not server.keep_alive
      request_keep_alive = false
    if server.stop_requested or should_force_close(server)
      request_keep_alive = false

    phase = "handler"
    try
      res = server.handler(req)
      server.request_count = server.request_count + 1
      phase = "normalize"
      normalized = server.normalize_response(res)
      if is_stream_response(normalized)
        phase = "stream_send"
        ok = send_chunked_stream(server, client, normalized, request_keep_alive)
        if not ok
          break
      else
        phase = "send"
        payload = normalized
        try
          payload = decorate_connection_headers(normalized, request_keep_alive)
        except e
          payload = normalized
        if not send_all(server, client, payload)
          if DEBUG_ERRORS
            print("[http_server] send_all failed for " + safe_str(req.method) + " " + safe_str(req.path))
          break
    except e
      server.request_count = server.request_count + 1
      if DEBUG_ERRORS
        p = req != nil ? (req.path or "?") : "?"
        m = req != nil ? (req.method or "?") : "?"
        print("[http_server] request error (" + phase + ") " + safe_str(m) + " " + safe_str(p) + ": " + safe_str(e))
      payload = fallback_500
      try
        candidate = decorate_connection_headers(http.response(500, nil, "Internal Server Error"), false)
        if istype(candidate, "string")
          payload = candidate
      except inner
        payload = fallback_500
      try
        send_all(server, client, payload)
      except send_err
        nil
      break

    if not request_keep_alive
      if DEBUG_ERRORS
        print("[http_server] closing connection after response")
      break

  try
    client.close(client)
  except e
    nil
  if DEBUG_ERRORS
    print("[http_server] connection closed")
  if server.active_connections > 0
    server.active_connections = server.active_connections - 1
  return "done"

fn start_connection(server, client)
  co = coroutine.create(handle_connection)
  conn = {sock = client, coro = co, mode = "read"}
  ok, mode = coroutine.resume(co, server, client)
  update_connection_state(server, conn, mode)
  return conn

fn compact_connections(connections)
  active = {}
  for conn in connections
    if conn.mode != "dead"
      active <+ conn
    else
      close_connection(conn)
  return active

fn run_maintenance(server, last_gc_req)
  if server.gc_every_requests and server.gc_every_requests > 0
    if server.request_count > 0 and server.request_count % server.gc_every_requests == 0 and server.request_count != last_gc_req
      gc
      last_gc_req = server.request_count
      if server.trim_after_gc and os.trim
        os.trim()

  return last_gc_req

fn run_coroutine_loop(server)
  connections = {}
  last_gc_req = 0

  accepting = true
  while true
    if server.stop_requested and accepting
      close_server_socket(server)
      accepting = false

    if should_force_close(server)
      for conn in connections
        close_connection(conn)
      connections = {}
      break

    if not accepting and #connections == 0
      break

    accepted = 0
    if accepting
      accepted = accept_pending_connections(server, fn(client)
        tls_err = ensure_tls_on_client(server, client)
        if tls_err != true
          try
            client.close(client)
          except e
            nil
          return nil
        set_nonblocking(client)
        conn = start_connection(server, client)
        if conn.mode != "dead"
          connections <+ conn
        else
          close_connection(conn)
      )

    resumed = 0
    for conn in connections
      if conn.mode == "read"
        ok, mode = coroutine.resume(conn.coro, conn.sock)
        if not ok and DEBUG_ERRORS
          print("[http_server] connection coroutine error: " + safe_str(mode))
        update_connection_state(server, conn, mode)
        resumed = resumed + 1

    connections = compact_connections(connections)
    last_gc_req = run_maintenance(server, last_gc_req)
    if accepted == 0 and resumed == 0
      if thread and thread.sleep
        thread.sleep(0.001)
    if thread
      thread.yield()

  for conn in connections
    close_connection(conn)
  return "stopped"

fn run_worker_loop(server, queue, select_timeout)
  connections = {}

  while true
    got_new = false
    while true
      if should_force_close(server)
        for conn in connections
          close_connection(conn)
        return "stopped"
      item, ok = queue.tryrecv(queue)
      if not ok
        break
      got_new = true
      if item == "__stop__"
        for conn in connections
          close_connection(conn)
        return "stopped"

      conn = start_connection(server, item)
      if conn.mode != "dead"
        connections <+ conn
      else
        close_connection(conn)

    if #connections == 0 and not got_new
      if should_force_close(server)
        return "stopped"
      item = queue.recv(queue)
      if item == nil or item == "__stop__"
        return "stopped"
      conn = start_connection(server, item)
      if conn.mode != "dead"
        connections <+ conn
      else
        close_connection(conn)

    resumed = 0
    for conn in connections
      if conn.mode == "read"
        ok, mode = coroutine.resume(conn.coro, conn.sock)
        if not ok and DEBUG_ERRORS
          print("[http_server] worker connection coroutine error: " + safe_str(mode))
        update_connection_state(server, conn, mode)
        resumed = resumed + 1

    if resumed == 0 and not got_new
      thread.sleep(select_timeout)

    connections = compact_connections(connections)
    thread.yield()

fn run_threaded_loop(server)
  worker_count = int(server.worker_threads)
  if worker_count < 1
    return run_coroutine_loop(server)
  if thread == nil
    print "thread module unavailable; using coroutine loop"
    return run_coroutine_loop(server)

  queues = {}
  workers = {}
  for i in 1..worker_count
    q = thread.channel(server.worker_queue_capacity)
    queues[i] = q
    workers[i] = thread.spawn(run_worker_loop, server, q, server.worker_select_timeout)

  next_worker = 1
  last_gc_req = 0
  accepting = true
  while true
    if server.stop_requested and accepting
      close_server_socket(server)
      accepting = false

    if should_force_close(server)
      break
    if not accepting and server.active_connections <= 0
      break

    if accepting
      accepted = accept_pending_connections(server, fn(client)
        tls_err = ensure_tls_on_client(server, client)
        if tls_err != true
          try
            client.close(client)
          except e
            nil
          return nil
        set_nonblocking(client)
        target = queues[next_worker]
        next_worker = next_worker + 1
        if next_worker > worker_count
          next_worker = 1
        ok = target.send(target, client)
        if not ok
          client.close(client)
      )
      if accepted == 0
        thread.sleep(0.01)
    else
      thread.sleep(0.01)

    last_gc_req = run_maintenance(server, last_gc_req)
    thread.yield()

  for q in queues
    q.send(q, "__stop__")

  for worker in workers
    thread.join(worker)

  return "stopped"

Transport.run = fn(self, server_override = nil)
  server = server_override or self
  if server.running
    return false
  server.stop_requested = false
  server.stop_deadline = nil
  server.force_close = false
  server.active_connections = 0
  if server.ssl and socket.tls_available and socket.tls_available() != true
    error("http_server ssl=true but TLS is unavailable in this build")
  server.socket.bind(server.socket, server.host, server.port)
  server.socket.listen(server.socket, 128)
  -- Listener socket: short timeout accept tends to be more stable than
  -- strict nonblocking accept across platforms.
  server.socket.settimeout(server.socket, 0.01)
  server.running = true

  scheme = "HTTP"
  if server.ssl
    scheme = "HTTPS"
  print(scheme + " Server running on " + server.host + ":" + str(server.port))

  out = nil
  try
    if server.worker_threads and server.worker_threads > 0
      out = run_threaded_loop(server)
    else
      out = run_coroutine_loop(server)
  finally
    server.running = false
    close_server_socket(server)

  return out

return Transport
