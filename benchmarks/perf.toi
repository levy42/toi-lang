time = import time
string = import string
table = import table
math = import math

fn bench(name, func)
  start = time.clock()
  result = func()
  elapsed = time.clock() - start
  -- The result is printed so interpreter/JIT output can be diffed for
  -- correctness. Timing alone hides miscompiled (but fast) loops.
  print string.format("%s %f sec result=%.17g", name, elapsed, result)
  return result

fn bench_math()
  acc = 0
  for i in 1..20000000
    acc = acc + (i * 3.14159) / ((i % 97) + 1)
  return acc

fn bench_random()
  acc = 0
  for i in 1..4000000
    acc = acc + math.random()
  return acc


fn bench_string_concat()
  total = 0
  for pass in 1..200
    parts = {""}
    for i in 1..20000
      parts[i] = "abc"
    s = string.join("", parts)
    total += #s
  return total

fn bench_string_ops()
  total = 0
  for i in 1..140000
    s = f"the quick brown fox jumps over the lazy dog {i}"
    x = s.upper()
    y = x.lower()
    z = y[5..19]
    total = total + #z
  return total

fn bench_table()
  t = {0}
  table.reserve(t, 200000)
  for i in 1..200000
    t <+ i * 2
  sum = 0
  for pass in 1..50
    for i in 1..200000
      sum += t[i]
  return sum

fn bench_sort()
  values = {}
  total = 0
  for pass in 1..6
    values = {}
    table.reserve(values, 120000)
    for i in 1..120000
      values[i] = (i * 1103515245 + 12345) % 1000003
    table.sort(values)
    for i in 1..120000
      total += values[i]
  return total

fn bench_list_comprehension()
  t = {i * 3 for i in 1..200000}
  sum = 0
  for pass in 1..55
    for i in 1..200000
      sum += t[i]
  return sum

fn bench_calls()
  -- `return a + #b` (not `return a`): a callee that ignores its work can be
  -- miscompiled without changing the reported result, so the value here has to
  -- depend on both arguments for the interpreter/JIT diff to mean anything.
  fn add(a: int, b: str)
    return a + #b
  acc = 0
  for i in 1..6000000
    acc = add(acc, "df")
  return acc

fn bench_fstring()
  total = 0
  for i in 1..600000
    s = f"user:{i}-x{i % 10}"
    total = total + #s
  return total

fn bench_app_pipeline()
  methods = {"GET", "POST", "PUT", "DELETE"}
  paths = {"/users", "/teams", "/search", "/assets", "/health", "/events"}

  routes = {}
  routes["GET /users"] = 1
  routes["POST /users"] = 2
  routes["GET /teams"] = 3
  routes["PUT /teams"] = 4
  routes["GET /search"] = 5
  routes["GET /assets"] = 6
  routes["GET /health"] = 7
  routes["POST /events"] = 8

  cache = {}
  total = 0
  for i in 1..600000
    method = methods[(i % 4) + 1]
    path = paths[(i % 6) + 1]
    key = f"{method} {path}"

    route = routes[key]
    if not route
      route = 0

    auth = (i % 3) != 0
    user_id = i % 10000
    team_id = i % 100
    body_size = (i * 37) % 2048

    status = 200
    if not auth and path != "/health"
      status = 401
    elif method == "POST" and body_size < 32
      status = 422
    elif route == 0
      status = 404

    cache_key = f"{path}:{user_id % 32}:{team_id}"
    cached = cache[cache_key]
    if cached
      total = total + cached
    else
      cache_value = route + status + body_size
      cache[cache_key] = cache_value
      total = total + cache_value

    total = total + status + route + user_id + team_id

  return total

fn bench_app_handlers()
  methods = {"GET", "GET", "GET", "POST", "GET", "PUT", "DELETE", "GET"}
  paths = {"/users", "/teams", "/users", "/events", "/health", "/teams", "/assets", "/users"}

  fn h_users(route, status, body_size, user_id, team_id)
    return route + status + body_size + (user_id % 7) + (team_id % 5)

  fn h_teams(route, status, body_size, user_id, team_id)
    return route + status + (body_size % 97) + (user_id % 11) + (team_id % 3)

  fn h_events(route, status, body_size, user_id, team_id)
    return route + status + body_size + (user_id % 13) + (team_id % 17)

  fn h_health(route, status, body_size, user_id, team_id)
    return route + status + (body_size % 17) + (user_id % 5) + (team_id % 2)

  fn h_fallback(route, status, body_size, user_id, team_id)
    return route + status + body_size + user_id + team_id

  handlers = {}
  handlers["GET /users"] = h_users
  handlers["GET /teams"] = h_teams
  handlers["POST /events"] = h_events
  handlers["GET /health"] = h_health

  routes = {}
  routes["GET /users"] = 1
  routes["GET /teams"] = 3
  routes["POST /events"] = 8
  routes["GET /health"] = 7

  total = 0
  for i in 1..600000
    method = methods[(i % 8) + 1]
    path = paths[(i % 8) + 1]
    key = f"{method} {path}"
    route = routes[key]
    if not route
      route = 0

    auth = (i % 3) != 0
    body_size = (i * 37) % 2048
    user_id = i % 10000
    team_id = i % 100

    status = 200
    if not auth and path != "/health"
      status = 401
    elif method == "POST" and body_size < 32
      status = 422
    elif route == 0
      status = 404

    handler = handlers[key]
    if not handler
      handler = h_fallback
    total = total + handler(route, status, body_size, user_id, team_id)
  return total

fn bench_memory()
  gc
  base = mem()
  t = {}
  for i in 1..500000
    t[i] = string.format("abc%d", i)
  gc
  used = mem() - base
  return used

print("Toi perf (clock):")
bench("math", bench_math)
bench("random", bench_random)
bench("string concat", bench_string_concat)
bench("string ops", bench_string_ops)
bench("table", bench_table)
bench("sort", bench_sort)
bench("list comprehension", bench_list_comprehension)
bench("calls", bench_calls)
bench("f-string", bench_fstring)
bench("app pipeline", bench_app_pipeline)
bench("app handlers", bench_app_handlers)
used = bench("memory", bench_memory)
print string.format("memory %d bytes", used)
