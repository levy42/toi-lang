http_server = import lib.http_server
os = import os

app = http_server(host="127.0.0.1", port=8080)
get = app.get

@get("/")
fn home(req)
  return "ok"

@get("/health")
fn health(req)
  return {ok = true, ts = os.clock()}

print "simple http_server example running on http://127.0.0.1:8080"
print "routes: GET /, GET /health"
app.run()
